# Optional overrides consumed by config.py
LPR_DEVICE=0
LPR_YOLO_WEIGHTS=deploy/models/yolov8n_plate.onnx
LPR_OCR_USE_GPU=false
LPR_OCR_REC_MODEL_DIR=deploy/models/ocr_rec
LPR_OCR_LANG=ch
LPR_LOG_LEVEL=INFO

# Web service
LPR_WEB_TOKEN=
LPR_MAX_UPLOAD_MB=15
LPR_MAX_IMAGE_SIDE=2200
LPR_RATE_LIMIT=30
LPR_WARMUP=true
LPR_ONNX_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider
